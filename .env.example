
# AI infrastructure (server-only; never use VITE_ prefix)
AI_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=12000
OPENROUTER_MAX_TOKENS=500

# Scan struk pengeluaran (server-only; never use VITE_ prefix). The key is a Helipod AI Gateway key
# (hel_ai_...). Without it the Scan button stays hidden. Models and limits live in Admin → Settings.
HELIPOD_AI_KEY=
HELIPOD_AI_BASE_URL=

# Ide tempat di Agenda (server-only; never use VITE_ prefix). Web search + fetch from TinyFish
# (https://agent.tinyfish.ai/api-keys); the AI summary uses HELIPOD_AI_KEY above. Without both keys
# the carousel and the "Ke mana lagi ya?" sheet stay hidden. Limits and model live in Admin → Settings.
TINYFISH_API_KEY=

# Admin authorization (server-only; exact emails are normalized lowercase)
ADMIN_EMAILS=fakhriazzamm@gmail.com

# Provider-balance sellability (server-only). Set to `on` in production; use `shadow` first if needed.
TRAVEL_SELLABILITY_MODE=off

# Djiwa Pay direct wallet checkout (server-only; same value as auth-server)
DJIWA_TRAVEL_WALLET_PAYMENT_SECRET=

# eSIM Access (server-only; never use VITE_ prefix)
ESIM_ACCESS_CODE=
ESIM_ACCESS_SECRET_KEY=
ESIM_ACCESS_WEBHOOK_TOKEN=
ESIM_ACCESS_WEBHOOK_LOG_PATH=/var/lib/djiwatravel/esim-access-webhooks.jsonl

# Payment sweep + Djiwa Finance (server-only)
ESIM_SYNC_TASK_SECRET=
DJIWA_TRAVEL_FINANCE_SETTLEMENT_URL=
DJIWA_TRAVEL_SETTLEMENT_SECRET=

# Transactional preorder email (server-only). The sender must be verified in Helipod Email.
HELIPOD_EMAIL_API_KEY=
HELIPOD_EMAIL_FROM=
HELIPOD_EMAIL_PROJECT_ID=
TRAVEL_PUBLIC_ORIGIN=https://djiwatravel.com

# Web Push (PWA). Generate with: npx web-push generate-vapid-keys
# Public key is sent to browsers; the private key stays server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@djiwatravel.com

# Djiwa Pay callback + eSIM sync task (server-only; checked by Admin → Settings readiness)
DJIWA_TRAVEL_CALLBACK_SECRET=
ESIM_SYNC_TASK_SECRET=

# Affiliate sweep task + click hashing (server-only; optional)
AFFILIATE_TASK_SECRET=
AFFILIATE_HASH_SALT=

# Agenda place search, reverse lookup and place-ideas map check (server-only). Set MAPTILER_API_KEY
# to use MapTiler Cloud (needs a plan that allows commercial use). PLACE_SEARCH_PROVIDER=photon|maptiler
# forces one provider; PLACE_SEARCH_URL points at a self-hosted Photon when no key is set.
MAPTILER_API_KEY=
# PLACE_SEARCH_PROVIDER=maptiler
# PLACE_SEARCH_URL=https://photon.komoot.io/api/

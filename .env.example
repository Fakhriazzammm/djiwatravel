
# AI infrastructure (server-only; never use VITE_ prefix)
AI_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=12000
OPENROUTER_MAX_TOKENS=500

# Admin authorization (server-only; exact emails are normalized lowercase)
ADMIN_EMAILS=fakhriazzamm@gmail.com

# Provider-balance sellability (server-only). Set to `on` in production; use `shadow` first if needed.
TRAVEL_SELLABILITY_MODE=off

# Djiwa Pay direct wallet checkout (server-only; same value as auth-server)
DJIWA_TRAVEL_WALLET_PAYMENT_SECRET=

# eSIM Access (server-only; never use VITE_ prefix)
ESIM_ACCESS_CODE=
ESIM_ACCESS_SECRET_KEY=
ESIM_ACCESS_WEBHOOK_TOKEN=
ESIM_ACCESS_WEBHOOK_LOG_PATH=/var/lib/djiwatravel/esim-access-webhooks.jsonl

# Web Push (PWA). Generate with: npx web-push generate-vapid-keys
# Public key is sent to browsers; the private key stays server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@djiwatravel.com

# Djiwa Pay callback + eSIM sync task (server-only; checked by Admin → Settings readiness)
DJIWA_TRAVEL_CALLBACK_SECRET=
ESIM_SYNC_TASK_SECRET=
